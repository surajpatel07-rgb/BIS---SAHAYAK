# Frontend build-time configuration (Vite inlines these at BUILD time).
# Copy to .env.production.local / .env.local as needed — never commit real secrets.

# Absolute URL of the backend API. Required when the frontend is served from a
# different origin (e.g. Vercel frontend -> Render backend).
# Leave EMPTY for same-origin setups (Vite dev proxy locally, or the
# single-service deploy where FastAPI serves the built frontend).
# Example:
# VITE_API_BASE_URL=https://bis-sahayak-jbim.onrender.com
VITE_API_BASE_URL=
