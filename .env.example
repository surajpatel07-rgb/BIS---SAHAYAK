# ============================================================
# BIS Buddy — Environment configuration (copy to .env)
#   cp .env.example .env
# NEVER commit the real .env file.
# ============================================================

# --- Security ---
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# Local dev default is SQLite (zero setup). For Postgres+pgvector use:
# postgresql+psycopg://bisbuddy:bisbuddy@localhost:5432/bisbuddy
DATABASE_URL=sqlite:///./data/bisbuddy.db

# --- LLM (Gemini) ---
# Full walkthrough: see GEMINI_SETUP.md in the project root.
# Get a free key: https://aistudio.google.com/apikey
# If empty, the app runs in LOCAL_EXTRACTIVE fallback mode (no external calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Thinking models spend part of this budget on internal reasoning — keep it generous
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Embeddings ---
# gemini | hash  (hash = deterministic local fallback, no API needed)
# Switching to gemini? Re-index afterwards: python scripts/reindex_all.py
# (see GEMINI_SETUP.md for the full walkthrough)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=768
# Used when EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Retrieval / RAG ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=12
RERANK_TOP_N=5
MIN_RELEVANCE_SCORE=0.08
# lexical | hybrid  (hybrid mixes vector similarity with keyword score)
RETRIEVAL_MODE=hybrid

# --- Ingestion ---
# Max allowed PDF upload size in MB
MAX_UPLOAD_MB=25

# --- CORS ---
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App ---
LOG_LEVEL=INFO
DATA_DIR=./data
